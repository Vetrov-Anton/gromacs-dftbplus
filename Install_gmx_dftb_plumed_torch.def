Bootstrap: docker
From: ubuntu:24.04

# ---------------------------------------------------------------------------
# GROMACS 2021.7 (double precision, OpenMPI) with DFTB+ QM/MM and PLUMED.
#
#   DFTB+    : QM/MM backend, located with find_package(DftbPlus CONFIG)
#   PLUMED   : installed by `plumed patch`, linked in runtime mode, so the
#              PLUMED build can be swapped afterwards through PLUMED_KERNEL
#   libtorch : lets PLUMED build its pytorch module (neural-network CVs)
#
# ubuntu:24.04 carries GCC 13 and CMake 3.28, the combination this tree builds
# with; GROMACS 2021.7 predates GCC 14/15 and CMake 4.
#
# Build:
#     apptainer build --fakeroot gmx_dftbplus.sif Install_gmx_dftb_plumed_torch.def
# ---------------------------------------------------------------------------

%post -c /bin/bash
    set -e -x
    export DEBIAN_FRONTEND=noninteractive

    # ------------------------- knobs (edit here) -----------------------
    NJOBS=6
    SRC=/opt/src                   # not /tmp: the host /tmp is bind-mounted
                                   # into the container during the build
    GROMACS_REPO=https://github.com/Vetrov-Anton/gromacs-dftbplus.git
    GROMACS_BRANCH=develop
    DFTBPLUS_VERSION=25.1          # any release with the modern C API (>= 23.1)
    PLUMED_VERSION=2.9.5           # last PLUMED line shipping the official
                                   # patches/gromacs-2021.7; 2.10 starts at
                                   # gromacs-2022.5
    LIBTORCH_VERSION=1.13.1        # PLUMED 2.9 supports 1.8.* .. 1.13.* only
    WITH_LIBTORCH=yes              # "no" skips libtorch and the pytorch CVs
    PLUMED_MODE=runtime            # runtime | shared  (runtime recommended)
    # -------------------------------------------------------------------

    mkdir -p ${SRC}

    # ------------------------------------------------------------------
    # 1. Toolchain and libraries
    # ------------------------------------------------------------------
    apt-get update -y
    apt-get install -y --no-install-recommends -o Acquire::Retries=5 \
        ca-certificates wget git unzip xxd patch file \
        build-essential gfortran \
        cmake ninja-build \
        libopenblas-dev liblapack-dev \
        libgsl-dev zlib1g-dev libfftw3-dev \
        libopenmpi-dev openmpi-bin \
        python3 python3-dev \
        vim nano less htop
    cmake --version
    gcc --version | head -1

    # ------------------------------------------------------------------
    # 2. DFTB+  ->  /opt/dftbplus
    #    Shared build with the C API on; GROMACS finds it through
    #    /opt/dftbplus/lib/cmake/dftbplus/dftbplus-config.cmake
    # ------------------------------------------------------------------
    cd ${SRC}
    rm -rf dftbplus
    git clone --recursive --depth 1 -b ${DFTBPLUS_VERSION} \
        https://github.com/dftbplus/dftbplus.git
    cd dftbplus
    cmake -B _build -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/opt/dftbplus \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_SHARED_LIBS=ON \
        -DWITH_API=ON \
        -DENABLE_DYNAMIC_LOADING=ON \
        -DWITH_TBLITE=ON \
        -DWITH_SDFTD3=ON \
        -DWITH_MPI=OFF \
        -DWITH_OMP=ON \
        -DWITH_PYTHON=OFF \
        -DBUILD_TESTING=OFF \
        -DHYBRID_CONFIG_METHODS="Submodule;Find;Fetch"
    cmake --build _build -- -j${NJOBS}
    cmake --install _build
    test -f /opt/dftbplus/lib/cmake/dftbplus/dftbplus-config.cmake
    cd ${SRC} && rm -rf dftbplus

    # ------------------------------------------------------------------
    # 3. libtorch  ->  /opt/libtorch
    # ------------------------------------------------------------------
    if [ "${WITH_LIBTORCH}" = "yes" ]; then
        cd ${SRC}
        # The cxx11-abi archive must come first: at 1.13.1 both names exist and
        # the one without the infix is the pre-cxx11 ABI build, which would also
        # need CXXFLAGS="-D_GLIBCXX_USE_CXX11_ABI=0".  wget -O leaves a stub
        # behind on a 404, so check the result here rather than meeting it later
        # as an unzip failure.
        LT_URL=https://download.pytorch.org/libtorch/cpu
        rm -f libtorch.zip
        for _n in "libtorch-cxx11-abi-shared-with-deps-${LIBTORCH_VERSION}%2Bcpu.zip" \
                  "libtorch-shared-with-deps-${LIBTORCH_VERSION}%2Bcpu.zip"; do
            if wget -q --no-check-certificate -O libtorch.zip "${LT_URL}/${_n}"; then
                echo "libtorch archive: ${_n}"
                break
            fi
            rm -f libtorch.zip
        done
        test -s libtorch.zip
        unzip -tq libtorch.zip
        cd /opt && unzip -q ${SRC}/libtorch.zip
        rm -f ${SRC}/libtorch.zip
    fi

    # ------------------------------------------------------------------
    # 4. PLUMED  ->  /opt/plumed
    # ------------------------------------------------------------------
    cd ${SRC}
    wget -q --no-check-certificate \
        https://github.com/plumed/plumed2/releases/download/v${PLUMED_VERSION}/plumed-src-${PLUMED_VERSION}.tgz
    rm -rf plumed-${PLUMED_VERSION}
    tar xf plumed-src-${PLUMED_VERSION}.tgz
    cd plumed-${PLUMED_VERSION}

    PLUMED_CONF_EXTRA=""
    if [ "${WITH_LIBTORCH}" = "yes" ]; then
        export CPATH=${CPATH:-}:/opt/libtorch/include/torch/csrc/api/include:/opt/libtorch/include
        export LIBRARY_PATH=${LIBRARY_PATH:-}:/opt/libtorch/lib
        export LD_LIBRARY_PATH=${LD_LIBRARY_PATH:-}:/opt/libtorch/lib
        PLUMED_CONF_EXTRA="--enable-libtorch"
    fi
    export PYTHON_BIN=$(which python3)

    ./configure --prefix=/opt/plumed --enable-modules=all ${PLUMED_CONF_EXTRA}
    make -j${NJOBS}
    make install
    test -f /opt/plumed/lib/libplumedKernel.so
    cd ${SRC} && rm -rf plumed-${PLUMED_VERSION} plumed-src-${PLUMED_VERSION}.tgz

    # ------------------------------------------------------------------
    # 5. GROMACS  ->  /opt/gmx
    #
    #    The non-QM/MM part of this tree is release GROMACS 2021.7, which is
    #    what patches/gromacs-2021.7 expects, so `plumed patch` applies with no
    #    fuzz.  It also drops Plumed.h, Plumed.cmake and Plumed.inc into the
    #    source root.  Revert with: plumed patch -r -e gromacs-2021.7
    # ------------------------------------------------------------------
    cd ${SRC}
    rm -rf gromacs-dftbplus
    git clone --depth 1 -b ${GROMACS_BRANCH} ${GROMACS_REPO} gromacs-dftbplus
    cd gromacs-dftbplus
    git log -1 --format='building %H (%ad)' --date=short

    export PATH=/opt/plumed/bin:${PATH}
    export LD_LIBRARY_PATH=/opt/plumed/lib:${LD_LIBRARY_PATH:-}
    plumed patch -p -e gromacs-2021.7 -m ${PLUMED_MODE}
    test -e Plumed.h && test -e Plumed.inc && test -e Plumed.cmake

    mkdir -p build && cd build
    # GMX_QMMM_DFTBPLUS_LIB is the DFTB+ install PREFIX, not <prefix>/lib.
    cmake .. \
        -DCMAKE_INSTALL_PREFIX=/opt/gmx \
        -DCMAKE_BUILD_TYPE=Release \
        -DGMX_QMMM_PROGRAM=dftbplus \
        -DGMX_QMMM_DFTBPLUS_LIB=/opt/dftbplus \
        -DGMX_DOUBLE=ON \
        -DGMX_MPI=ON \
        -DGMX_THREAD_MPI=OFF \
        -DGMX_OPENMP=ON \
        -DGMX_GPU=OFF \
        -DGMX_DEFAULT_SUFFIX=OFF \
        -DGMXAPI=OFF \
        -DGMX_INSTALL_NBLIB_API=OFF \
        -DGMX_BUILD_OWN_FFTW=ON \
        -DGMX_BUILD_MANUAL=OFF \
        -DBUILD_TESTING=OFF \
        -DGMX_BUILD_UNITTESTS=OFF \
        -DCMAKE_INSTALL_RPATH_USE_LINK_PATH=ON \
        -DCMAKE_INSTALL_RPATH="/opt/dftbplus/lib;/opt/plumed/lib"
    make -j${NJOBS}
    make install
    cd ${SRC} && rm -rf gromacs-dftbplus

    # ------------------------------------------------------------------
    # 6. Cleanup
    # ------------------------------------------------------------------
    apt-get clean
    rm -rf /var/lib/apt/lists/*

%environment
    export LC_ALL=C
    export PATH=/opt/gmx/bin:/opt/plumed/bin:/opt/dftbplus/bin:${PATH}
    export LD_LIBRARY_PATH=/opt/gmx/lib:/opt/gmx/lib64:/opt/dftbplus/lib:/opt/plumed/lib:/opt/libtorch/lib:${LD_LIBRARY_PATH}
    # PLUMED is runtime-linked: this variable is the only thing tying gmx to a
    # particular PLUMED build, so another one needs no GROMACS rebuild.
    export PLUMED_KERNEL=/opt/plumed/lib/libplumedKernel.so
    export PLUMED_ROOT=/opt/plumed/lib/plumed
    export OMP_NUM_THREADS=1
    # QM/MM settings of this image (README.md); override per run with --env VAR=value.
    # Electrostatics: 0 none, 1 PME, 2 switched cut-off, 3 reaction field, 4 shifted
    export GMX_QMMM_VARIANT=1
    # grompp: bonded terms at the QM/MM boundary, and the QM-MM Lennard-Jones
    export GMX_QMMM_BONDED_SCHEME=classic
    export GMX_QMMM_LJ_SCHEME=forcefield
    # mdrun: charges of the MM1 atoms in the external potential passed to DFTB+
    export GMX_QMMM_POT_SCHEME=CS
    # mdrun: QM-MM pairs removed (1-2, 1-3) and scaled (1-4) in the QM/MM gradient,
    #   and the link atoms treated as their MM1 atom there
    export GMX_QMMM_GRAD_EXCL=3
    export GMX_QMMM_GRAD_LA=MM1

%runscript
    exec gmx "$@"

%test
    export PATH=/opt/gmx/bin:/opt/plumed/bin:${PATH}
    export LD_LIBRARY_PATH=/opt/gmx/lib:/opt/gmx/lib64:/opt/dftbplus/lib:/opt/plumed/lib:/opt/libtorch/lib:${LD_LIBRARY_PATH:-}
    export PLUMED_KERNEL=/opt/plumed/lib/libplumedKernel.so
    gmx --version | head -20
    plumed info --version

    gmx --version | grep -q "2021.7-plumed-2.9.5" && \
        echo "OK: version string reports 2021.7 patched by PLUMED 2.9.5" || \
        echo "WARNING: unexpected version string"

    gmx mdrun -h 2>&1 | grep -q -- '-plumed' && echo "OK: gmx mdrun has -plumed"
    gmx mdrun -h 2>&1 | grep -q 'hrex' && \
        echo "OK: gmx mdrun has -hrex" || \
        echo "WARNING: no -hrex in mdrun options"

    ldd /opt/gmx/lib/libgromacs.so | grep -qi dftb && echo "OK: libgromacs links DFTB+"
    ldd /opt/gmx/lib/libgromacs.so | grep -qi plumed && \
        echo "WARNING: libgromacs has a hard PLUMED dependency (expected: none)" || \
        echo "OK: no DT_NEEDED on PLUMED - kernel is dlopen'ed via PLUMED_KERNEL"

    # PYTORCH is the module libtorch is there for; if the linkage silently
    # failed, configure only warned and this action would be missing.
    plumed --no-mpi manual --action PYTORCH_MODEL >/dev/null 2>&1 && \
        echo "OK: PLUMED has the PYTORCH module (libtorch linked)" || \
        echo "WARNING: no PYTORCH module - libtorch linkage failed"

%labels
    Author      Anton Vetrov <vetrov.anton.a@gmail.com>
    GROMACS     2021.7, DFTB+ QM/MM
    QMMM        DFTB+
    PLUMED      2.9.5, runtime-linked, installed by `plumed patch`

%help
    GROMACS 2021.7 (double precision, OpenMPI) with DFTB+ QM/MM and PLUMED.

    The sources are cloned from github.com/Vetrov-Anton/gromacs-dftbplus during
    the build.  Everything outside QM/MM is release GROMACS 2021.7, and PLUMED
    is applied by its own `plumed patch -e gromacs-2021.7`.  PLUMED is pinned to
    2.9.5: it is the last line that still ships that patch (2.10 starts at
    gromacs-2022.5).  libtorch is pinned to 1.13.1 because PLUMED 2.9 supports
    1.8.* to 1.13.* only.

    Build
    -----
        apptainer build --fakeroot gmx_dftbplus.sif Install_gmx_dftb_plumed_torch.def

    Run
    ---
        apptainer exec gmx_dftbplus.sif gmx grompp -f md.mdp -c c.gro -p t.top -o md.tpr
        apptainer exec gmx_dftbplus.sif mpirun -np 1 gmx mdrun -deffnm md -plumed plumed.dat

    QM/MM settings of this image
    ----------------------------
    Presets of the image environment, each overridable per run with
    --env VAR=value:

        GMX_QMMM_VARIANT=1             PME electrostatics between QM and MM
        GMX_QMMM_BONDED_SCHEME=classic grompp: remove a bonded term at the
                                       boundary when all but one atom is QM
        GMX_QMMM_LJ_SCHEME=forcefield  grompp: QM-MM Lennard-Jones by the
                                       exclusion rules of the force field
        GMX_QMMM_POT_SCHEME=CS         mdrun: the MM1 charge is shifted to the
                                       MM2 atoms, with a dipole-restoring pair
                                       of point charges, in the potential
                                       passed to DFTB+ (none|RC|RCD|CS|AMBER)
        GMX_QMMM_GRAD_EXCL=3           mdrun: QM-MM gradient without the 1-2
                                       and 1-3 pairs, 1-4 pairs scaled by
                                       fudgeQQ (0|1|2|3|BONDED)
        GMX_QMMM_GRAD_LA=MM1           mdrun: link atoms are excluded in the
                                       gradient as if they were their MM1 atom

    The potential and the gradient follow separate rules.  mdrun prints the
    settings in effect, and grompp and mdrun write qmmm_topology_report.txt
    and qmmm_exclusion_report.txt with every removed term and every removed or
    scaled QM-MM pair (GMX_QMMM_REPORTS=off switches them off).  See README.md
    for all variables.

    Other notes
    -----------
      * DFTB+ needs a dftb_in.hsd in the working directory, and the QM atom
        ORDER there must match the QM group of the .mdp.  Slater-Koster
        parameter sets (e.g. 3ob-3-1) are NOT bundled - fetch them from
        dftb.org.
      * A dftb_in.hsd written for DFTB+ 21.2 needs one edit: replace
        Analysis{CalculateForces} with Analysis{PrintForces}.  Without it the
        parser halts on the unknown key, and merely deleting the key makes the
        run die after the SCC with "Forces not available".
      * The GROMACS QM/MM interface has no domain decomposition - use a single
        rank.
      * Swapping PLUMED without rebuilding GROMACS:
            apptainer exec -B /my/plumed:/my/plumed \
                --env PLUMED_KERNEL=/my/plumed/lib/libplumedKernel.so \
                gmx_dftbplus.sif gmx mdrun ...
