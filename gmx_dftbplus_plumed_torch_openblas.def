Bootstrap: docker
From: ubuntu:20.04
Stage: spython-base

%labels
    MAINTAINER Arthur Zalevsky <aozalevsky@gmail.com>

%environment
    export LD_LIBRARY_PATH=${LD_LIBRARY_PATH}:/opt/dftbplus/lib:/opt/libtorch/lib:/opt/plumed/lib:/opt/gmx/lib
    export PATH=${PATH}:/opt/dftbplus/bin:/opt/plumed/bin:/opt/gmx/bin
    export GMX_QMMM_VARIANT=1
    export OMP_NUM_THREADS=1

#%arguments
    # By default use 8 cores for compilation
#    NJOBS=8

%post -c /bin/bash
    # Some build-time definitions
    export TMPDIR=/tmp
    export DEBIAN_FRONTEND=noninteractive

    # Install dependencies for gromacs and dftbplus
    apt-get update -y
    apt-get install -y --no-install-recommends \
        ca-certificates \
        wget git \
        build-essential \
        gfortran \
        xxd unzip \
        libopenblas-dev \
        libgsl-dev \
        zlib1g-dev \
        libfftw3-dev \
        libopenmpi-dev \
        python3 python3-dev python3-pip \
        tmux vim less htop 
    
    # Install python dependencies
    pip3 install -U setuptools cython==0.29.33 "cmake<4"
  
    # Install DFTB+
    DFTBPLUS_VERSION=21.2
    mkdir -p ${TMPDIR} && cd ${TMPDIR}
    wget https://github.com/dftbplus/dftbplus/releases/download/${DFTBPLUS_VERSION}/dftbplus-${DFTBPLUS_VERSION}.tar.xz
    # Ensure that we are using a fresh copy
    rm -rf dftbplus-${DFTBPLUS_VERSION} && tar xf dftbplus-${DFTBPLUS_VERSION}.tar.xz
    cd dftbplus-${DFTBPLUS_VERSION}
    mkdir -p build && cd build
    cmake .. -DWITH_API=TRUE -DWITH_TBLITE=TRUE -DWITH_SDFTD3=TRUE -DBUILD_SHARED_LIBS=TRUE -DENABLE_DYNAMIC_LOADING=TRUE -DCMAKE_INSTALL_PREFIX=/opt/dftbplus
    make -j 8 && make install
    # Cleanup
    cd ${TMPDIR} && rm -rf dftbplus-${DFTBPLUS_VERSION} dftbplus-${DFTBPLUS_VERSION}.tar.xz

    # Install plumed for compilation
    PLUMED_VERSION=2.7.4
    mkdir -p ${TMPDIR} && cd ${TMPDIR}
    wget -q -nc --no-check-certificate https://github.com/plumed/plumed2/releases/download/v${PLUMED_VERSION}/plumed-src-${PLUMED_VERSION}.tgz
    # Ensure that we are using a fresh copy
    rm -rf plumed-src-${PLUMED_VERSION} && tar xf plumed-src-${PLUMED_VERSION}.tgz
    cd plumed-${PLUMED_VERSION}
    ./configure --prefix=/opt/plumed
    make -j 8
    make install
    cd ${TMPDIR} && rm -rf plumed-src-${PLUMED_VERSION} plumed-src-${PLUMED_VERSION}.tgz 
   
    # Install gromacs-dftbplus
    mkdir -p ${TMPDIR} && cd ${TMPDIR}
    # Ensure that we are using a fresh copy
    rm -rf gromacs-dftbplus && git clone https://github.com/Vetrov-Anton/gromacs-dftbplus.git
    cd gromacs-dftbplus

    # Patch paths to DFTB+ shared libs
    sed 's/libdftbplus.a/libdftbplus.so/' -i src/programs/CMakeLists.txt 
    sed 's/libdftd3.a/libs-dftd3.so/' -i src/programs/CMakeLists.txt 
    sed 's/libmudpack.a/libmudpack.so/' -i src/programs/CMakeLists.txt 

    # Manual patch for PLUMED
    ln -s /opt/plumed/include/plumed/wrapper/Plumed.h
    echo -e '# PLUMED: shared installation\nset(PLUMED_LOAD  "/opt/plumed/lib/libplumed.so" -ldl  )\nset(PLUMED_DEPENDENCIES  "/opt/plumed/lib/libplumed.so")' > Plumed.cmake
    echo -e '# PLUMED: shared installation\nPLUMED_LOAD= "/opt/plumed/lib/libplumed.so" -ldl  \nPLUMED_DEPENDENCIES="/opt/plumed/lib/libplumed.so"' > Plumed.in

    mkdir -p build && cd build
    cmake .. -DCMAKE_INSTALL_PREFIX=/opt/gmx -DGMX_DOUBLE=ON -DGMX_MPI=ON -DGMX_OPENMP=ON -DGMX_GPU=OFF -DGMX_DEFAULT_SUFFIX=OFF \
        -DGMXAPI=OFF -DGMX_INSTALL_NBLIB_API=OFF \
        -DGMX_BUILD_OWN_FFTW=ON \
        -DGMX_PLUMED=ON \
        -DGMX_QMMM_PROGRAM=dftbplus -DGMX_QMMM_DFTBPLUS_LIB=/opt/dftbplus/lib 
    make -j 8 && make install
    # Cleanup 
    cd ${TMPDIR} && rm -rf gromacs-dftbplus

    # Download and unpack libtorch
    mkdir -p ${TMPDIR} && cd ${TMPDIR}
    wget -q -nc --no-check-certificate https://download.pytorch.org/libtorch/cpu/libtorch-cxx11-abi-shared-with-deps-2.2.0%2Bcpu.zip
    cd /opt && unzip "${TMPDIR}/libtorch-cxx11-abi-shared-with-deps-2.2.0+cpu.zip" 
    # Cleanup
    cd ${TMPDIR} && rm -f "libtorch-cxx11-abi-shared-with-deps-2.2.0+cpu.zip"
    
    # Install latest PLUMED for calculations
    # Remove old PLUMED
    rm -rf /opt/plumed
    # Install new PLUMED
    PLUMED_VERSION=2.9.0
    mkdir -p ${TMPDIR} && cd ${TMPDIR}
    wget -q -nc --no-check-certificate https://github.com/plumed/plumed2/releases/download/v${PLUMED_VERSION}/plumed-src-${PLUMED_VERSION}.tgz
    # Ensure that we are using a fresh copy
    rm -rf plumed-${PLUMED_VERSION} && tar xf plumed-src-${PLUMED_VERSION}.tgz
    cd plumed-${PLUMED_VERSION}
    # Patch for compatibility with libtorch
    sed 's/c++14/c++17/' -i configure
    # Set compile-time paths to libtorch
    export CPATH=${CPATH}:/opt/libtorch/include/torch/csrc/api/include:/opt/libtorch/include
    export LIBRARY_PATH=${LIBRARY_PATH}:/opt/libtorch/lib
    export LD_LIBRARY_PATH=${LD_LIBRARY_PATH}:/opt/libtorch/lib
    # Set python path
    export PYTHON_BIN=$(which python3) 
    ./configure --prefix=/opt/plumed --enable-modules=all --enable-libtorch
    make -j 8 && make install
    # Cleanup
    cd ${TMPDIR} && rm -rf plumed-${PLUMED_VERSION} plumed-src-${PLUMED_VERSION}.tgz 
